{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustoverip.github.io/dtgwg-rahp-tf/schema/rahp.schema.json",
  "title": "RAHP record schemas",
  "description": "Structural schemas for RAHP artefact records. Controlled vocabulary values are checked separately by tools/validate.py against method/vocabularies.yaml, so that changing a vocabulary does not require editing this file.",

  "$defs": {
    "idList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provenance": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "imported": { "type": "string" },
        "note": { "type": "string" },
        "triggered_by": { "type": "string" },
        "contributor": { "type": "string" }
      },
      "required": ["source"],
      "additionalProperties": true
    },

    "risk": {
      "type": "object",
      "required": ["id", "name", "category", "severity", "likelihood", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 3 },
        "category": { "type": "string" },
        "lifecycle_phase": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 20 },
        "harm_types": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string" },
        "likelihood": { "type": "string" },
        "harm_description": { "type": ["string", "null"] },
        "affected_metrics": { "$ref": "#/$defs/idList" },
        "user_stories": { "$ref": "#/$defs/idList" },
        "scenarios": { "$ref": "#/$defs/idList" },
        "guardrails": { "$ref": "#/$defs/idList" },
        "controls": { "$ref": "#/$defs/idList" },
        "assurance_tests": { "$ref": "#/$defs/idList" },
        "epics": { "$ref": "#/$defs/idList" },
        "standards_priority": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "control": {
      "type": "object",
      "required": ["id", "name", "type", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string", "minLength": 20 },
        "guardrails": { "$ref": "#/$defs/idList" },
        "linked_risks": { "$ref": "#/$defs/idList" },
        "standards_relevance": { "type": ["string", "null"] },
        "standards_status": { "type": "string" },
        "normative_language": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "guardrail": {
      "type": "object",
      "required": ["id", "name", "requirement"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": ["string", "null"] },
        "requirement": { "type": "string", "minLength": 20 },
        "applies_to_phase": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "risks_addressed": { "$ref": "#/$defs/idList" },
        "controls": { "$ref": "#/$defs/idList" },
        "assurance_tests": { "$ref": "#/$defs/idList" },
        "standards_status": { "type": "string" },
        "normative_language": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "assurance_test": {
      "type": "object",
      "required": ["id", "guardrail", "pass_criterion"],
      "properties": {
        "id": { "type": "string" },
        "guardrail": { "type": ["string", "null"] },
        "pass_criterion": { "type": "string", "minLength": 10 },
        "verification_method": { "type": ["string", "null"] },
        "automated": { "type": "boolean" },
        "test_type": { "type": ["string", "null"] },
        "risks_covered": { "$ref": "#/$defs/idList" },
        "notes": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "metric": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 10 },
        "personas_want_high": { "$ref": "#/$defs/idList" },
        "personas_want_suppressed": { "$ref": "#/$defs/idList" },
        "risks_measured": { "$ref": "#/$defs/idList" },
        "user_stories": { "$ref": "#/$defs/idList" },
        "scenarios": { "$ref": "#/$defs/idList" },
        "epics": { "$ref": "#/$defs/idList" },
        "monitoring": {
          "description": "v0.4 runtime governance hook. Null until the monitoring layer is specified.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["signal", "responsible_role"],
              "properties": {
                "signal": { "type": "string" },
                "threshold_warn": { "type": ["number", "null"] },
                "threshold_critical": { "type": ["number", "null"] },
                "triage_workflow": { "type": ["string", "null"] },
                "responsible_role": { "type": "string" },
                "evidence_captured": { "type": "array", "items": { "type": "string" } },
                "notification_sla_hours": { "type": ["number", "null"] },
                "appeals_pathway": { "type": ["string", "null"] },
                "revocation_trigger": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "user_story": {
      "type": "object",
      "required": ["id", "function", "goal"],
      "properties": {
        "id": { "type": "string" },
        "persona": { "type": ["string", "null"] },
        "persona_label": { "type": ["string", "null"] },
        "function": { "type": "string", "minLength": 10 },
        "goal": { "type": "string", "minLength": 10 },
        "lifecycle_phase": { "type": ["string", "null"] },
        "scenarios": { "$ref": "#/$defs/idList" },
        "epics": { "$ref": "#/$defs/idList" },
        "risk_categories": { "type": "array", "items": { "type": "string" } },
        "metrics": { "$ref": "#/$defs/idList" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "scenario": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string", "minLength": 20 },
        "lifecycle_phase": { "type": ["string", "null"] },
        "legitimate_personas": { "$ref": "#/$defs/idList" },
        "adversarial_personas": { "$ref": "#/$defs/idList" },
        "governance_decisions": { "type": ["string", "null"] },
        "user_stories": { "$ref": "#/$defs/idList" },
        "metrics": { "$ref": "#/$defs/idList" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "epic": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "layer": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "personas": { "$ref": "#/$defs/idList" },
        "user_stories": { "$ref": "#/$defs/idList" },
        "metrics": { "$ref": "#/$defs/idList" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "persona": {
      "type": "object",
      "required": ["id", "name", "role", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "type": { "type": "string" },
        "adversarial": { "type": "boolean" },
        "organisational": { "type": "boolean" },
        "safeguarding": { "type": "boolean" },
        "safeguarding_note": { "type": "string" },
        "co_persona": { "type": ["string", "null"] },
        "quote": { "type": ["string", "null"] },
        "context": { "type": "object", "additionalProperties": true },
        "lifecycle_phases": { "type": "array", "items": { "type": "string" } },
        "goals": { "type": "array", "items": { "type": "string" } },
        "risk_context": { "type": "array", "items": { "type": "string" } },
        "inclusion_drivers": { "type": "array", "items": { "type": "string" } },
        "exclusion_risks": { "type": "array", "items": { "type": "string" } },
        "exploits": { "type": "array", "items": { "type": "string" } },
        "calibration": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "source"],
            "properties": {
              "claim": { "type": "string" },
              "source": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "recommendation": {
      "type": "object",
      "required": ["id", "class", "title", "statement", "status"],
      "properties": {
        "id": { "type": "string" },
        "class": { "enum": ["normative", "recommended", "process"] },
        "title": { "type": "string" },
        "statement": { "type": "string", "minLength": 30 },
        "target": { "type": ["string", "null"] },
        "status": { "enum": ["proposed", "accepted", "incorporated", "rejected", "superseded"] },
        "linked_guardrails": { "$ref": "#/$defs/idList" },
        "linked_controls": { "$ref": "#/$defs/idList" },
        "linked_risks": { "$ref": "#/$defs/idList" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "risk_acceptance": {
      "type": "object",
      "required": ["id", "risk_id", "decision", "rationale"],
      "properties": {
        "id": { "type": "string" },
        "risk_id": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "decision": { "type": "string" },
        "authority": { "type": ["string", "null"] },
        "decided_by": { "type": ["array", "string", "null"], "items": { "type": "string" } },
        "decision_date": { "type": ["string", "null"] },
        "rationale": { "type": "string", "minLength": 20 },
        "residual_risk": { "type": ["string", "null"] },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "review_date": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "blocked_by": { "type": "array", "items": { "type": "string" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },

    "governance_precedent": {
      "type": "object",
      "required": ["id", "title", "status", "context", "rationale"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "decision_date": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "context": { "type": "string", "minLength": 20 },
        "rationale": { "type": "string", "minLength": 20 },
        "linked_risks": { "$ref": "#/$defs/idList" },
        "linked_controls": { "$ref": "#/$defs/idList" },
        "linked_guardrails": { "$ref": "#/$defs/idList" },
        "evidence": { "type": ["string", "null"] },
        "superseded_by": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    }
  }
}
