{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental example-local TEA evidence sidecar",
  "type": "object",
  "required": [
    "schema",
    "assessment_id",
    "target",
    "method_revision",
    "review_binding",
    "risks_binding",
    "execution",
    "unassessed",
    "evidence",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "tea-example-evidence/v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^SR-[0-9]{3,}$"
    },
    "target": {
      "type": "object",
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "method_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "review_binding": {
      "$ref": "#/$defs/binding"
    },
    "risks_binding": {
      "$ref": "#/$defs/binding"
    },
    "execution": {
      "type": "object",
      "required": [
        "state",
        "observations"
      ],
      "properties": {
        "state": {
          "enum": [
            "complete",
            "failed",
            "incomplete"
          ]
        },
        "observations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "unassessed": {
      "type": "object",
      "required": [
        "tsp_transport",
        "vid_resolution",
        "revocation",
        "live_service",
        "full_tea_conformance"
      ],
      "properties": {
        "tsp_transport": {
          "const": "not-assessed"
        },
        "vid_resolution": {
          "const": "not-assessed"
        },
        "revocation": {
          "const": "not-assessed"
        },
        "live_service": {
          "const": "not-assessed"
        },
        "full_tea_conformance": {
          "const": "not-assessed"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "path",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-[0-9]{3}$"
              },
              "kind": {
                "const": "source"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "path",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-[0-9]{3}$"
              },
              "kind": {
                "const": "artifact"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "pointer",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-[0-9]{3}$"
              },
              "kind": {
                "const": "result"
              },
              "pointer": {
                "type": "string"
              },
              "expected": {}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence",
          "observation",
          "inference",
          "limitations",
          "treatment",
          "risk_reasoning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "observation": {
            "type": "string",
            "minLength": 10
          },
          "inference": {
            "type": "string",
            "minLength": 10
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "treatment": {
            "type": "string",
            "minLength": 10
          },
          "risk_reasoning": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
