{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustoverip.org/rahp/schema/spec-review-v1.schema.json",
  "title": "RAHP specification review record v1",
  "type": "object",
  "required": [
    "schema",
    "assessment_id",
    "target",
    "rahp_version",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "rahp-spec-review/v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^SR-[0-9]{3,}$"
    },
    "target": {
      "type": "object",
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rahp_version": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "risks",
          "control_plane",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RK-[A-Z]{1,2}[0-9]{2}$"
            }
          },
          "control_plane": {
            "enum": [
              "specification",
              "companion-specification",
              "governance",
              "implementation-guidance",
              "runtime-control",
              "operational-policy",
              "none"
            ]
          },
          "status": {
            "enum": [
              "open",
              "in_progress",
              "resolved",
              "risk_accepted",
              "out_of_scope",
              "superseded"
            ]
          },
          "resolution": {
            "type": "object",
            "required": [
              "type",
              "rationale"
            ],
            "properties": {
              "type": {
                "enum": [
                  "specification-change",
                  "companion-specification-change",
                  "governance-action",
                  "implementation-guidance",
                  "runtime-control",
                  "operational-policy",
                  "risk-acceptance",
                  "already-addressed",
                  "no-action",
                  "superseded"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "resolved",
                    "risk_accepted",
                    "out_of_scope",
                    "superseded"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "resolution"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "risk_accepted"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "resolution": {
                  "properties": {
                    "type": {
                      "const": "risk-acceptance"
                    }
                  },
                  "required": [
                    "reference"
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
