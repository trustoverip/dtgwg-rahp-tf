    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/GP-002",
      "@type": "GovernancePrecedent",
      "title": "R-DID per-relationship requirement reduces linkability risk",
      "decisionDate": "2026-03",
      "status": "proposed",
      "context": "Specification v0.3 made R-DIDs a MUST on a per-relationship basis. RAHP reassessed RK-ID05 (M-DID Linkability Across VTCs) and reduced its likelihood from Medium to Low as a direct result.",
      "rationale": "A specification change that measurably reduces an assessed risk should be recorded as precedent, not merely reflected in a changed score. Without the record, a future revision could reverse the design choice without anyone noticing the risk score was contingent on it.",
      "linkedRisks": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-ID05"
      ],
      "linked_controls": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/CT-15"
      ],
      "evidence": "DTG Credential Specification v0.3 review, March 2026 (risk register v5, section 6a)"
    },
    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/GP-003",
      "@type": "GovernancePrecedent",
      "title": "M-DID bootstrapping exception permitted without a migration trigger",
      "decisionDate": "2026-03",
      "status": "proposed",
      "context": "Specification v0.3 permits M-DID use during bootstrapping but defines no trigger for migration to R-DIDs. RAHP recorded this as a new risk (RK-SC04) introduced by a specification design choice, scored Medium severity x High likelihood.",
      "rationale": "Recorded as a precedent because it is a decision the working group may not have taken deliberately. The exception is reasonable for bootstrapping; the absence of a migration trigger is what converts a temporary allowance into a permanent weakening of the R-DID privacy model. CT-50 and GR-18 propose the trigger.",
      "linkedRisks": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-SC04"
      ],
      "linked_controls": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/CT-50"
      ],
      "linked_guardrails": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/GR-18"
      ],
      "evidence": "DTG Credential Specification v0.3 review, March 2026 (risk register v5, section 6b)"
    }
