    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-G01",
      "@type": "Risk",
      "name": "Genesis Policy Capture",
      "category": "Governance",
      "lifecyclePhase": "Phase 1",
      "description": "The initiator hard-codes biased, self-serving, or exclusionary policies at genesis before any oversight mechanism exists. Phase 1 concentrates all power in one person; these policies may persist and shape the entire community lifecycle.",
      "harmType": [
        "Governance Failure"
      ],
      "severity": "High",
      "likelihood": "Medium",
      "harm_description": "Biased or discriminatory membership criteria embedded permanently; initiator retains unchecked authority; downstream decisions tainted by flawed genesis assumptions.",
