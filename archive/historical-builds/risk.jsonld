    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-SC02",
      "@type": "Risk",
      "name": "Credential Schema Ambiguity",
      "category": "Schemas",
      "lifecyclePhase": "All phases",
      "description": "Underspecified VRC, VMC, or IDVC schemas lead to inconsistent implementation across personal network managers, VTAs, and IDVPs — creating interoperability failures and policy bypass opportunities. **SPEC UPDATE (v0.3 §2–§4):** The spec defines a formal W3C VC type hierarchy and normative base structure (§4), reducing schema ambiguity for the six DTG credential types. However, the DTG JSON-LD context (`firstperson.network/credentials/dtg/v1`) is not yet published as a resolvable normative artefact, and no conformance test suite exists. Schema ambiguity risk is partially reduced but not resolved.",
      "harmType": [
        "Technical Failure",
        "Governance Failure"
      ],
      "severity": "Medium",
      "likelihood": "Medium",
      "harm_description": "VTA rejects valid credentials due to schema mismatch; non-compliant implementations admit members who should be rejected; community trust damaged.",
      "affectedMetrics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-04",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-15"
