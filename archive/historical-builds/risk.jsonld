    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-EX04",
      "@type": "Risk",
      "name": "Child Safety Non-Compliance — Age Assurance Failure",
      "category": "External",
      "lifecyclePhase": "Phase 4 / Age-Restricted Use Cases",
      "description": "A minor successfully obtains or presents a valid-appearing over-18 IDVC, whether through IDVP failure, synthetic credential generation by Phantom (M2) or Viktor (B1), a ZKP implementation gap (RK-CY01), or an architecture flaw in the age assurance pathway. This is a non-negotiable child safety failure with criminal liability implications under the Online Safety Act 2023 for any age-restricted relying party (e.g., EC4 Velvet Gate). Unlike other register risks, this risk has a binary outcome: any non-zero incident rate is a system-level failure. The Ofcom regime provides no safe harbour for technical failure where the architecture was knowingly immature.",
      "harmType": [
        "Child Safety",
        "Criminal Liability"
      ],
      "severity": "Critical",
      "likelihood": "Medium",
      "harm_description": "A minor accesses age-restricted content due to a false-positive age assurance outcome. The relying party faces Ofcom enforcement action including fines up to £18 million or 10% of global qualifying revenue. Criminal liability for platform operators is possible under OSA 2023. The IDVP that issued the compromised credential faces deregistration and regulatory action. The DTG architecture's fitness for age-assurance use cases is brought into question, with potential for wider loss of trust in the ecosystem. The harm to the child is primary and irreversible.",
      "affectedMetrics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-04",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-36",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-37"
      ],
