    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-SC03",
      "@type": "Risk",
      "name": "VRC Over-Disclosure — Rich Data in Core Edge",
      "category": "Schemas",
      "lifecyclePhase": "All phases",
      "description": "The VRC schema (spec §5.2) requires only the target DID and proof, but places no constraint on what additional data may be embedded in `credentialSubject`. Implementers who embed rich relationship metadata — relationship duration, first-meeting location, mutual endorsements — directly in VRCs rather than using the annotation credential layer (VPC, VEC, VWC) create credentials in which both parties have cryptographically committed to that data. It cannot then be selectively disclosed or withheld from verifiers. The annotation credential architecture exists in the spec but is not normatively required as the channel for supplementary data. **Introduced by:** DTG Credential Spec v0.3 analysis (RAHP commentary §2.4).",
      "harmType": [
        "Privacy",
        "Data Protection"
      ],
      "severity": "Medium",
      "likelihood": "Medium",
      "harm_description": "Members inadvertently commit to more personal data than intended in bilateral VRCs; ZKP selective disclosure is undermined because the data is in the core credential, not an annotation; relationship graphs become richer surveillance targets than necessary.",
      "affectedMetrics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-09"
      ],
      "userStories": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/US-04",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/US-06"
      ],
      "scenarios": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/SC-03",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/SC-04"
      ],
      "guardrails": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/GR-06",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/GR-09"
      ],
      "controls": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/CT-49"
      ],
      "assuranceTests": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/AT-06",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/AT-09"
      ],
      "epics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/EPIC-9",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/EPIC-12"
      ],
      "standardsPriority": "should_address",
      "provenance": {
        "source": "workbook:RiskRegister_v5.xlsx",
        "imported": "2026-08-05"
      },
      "riskScore": 4
    },
    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-SC04",
      "@type": "Risk",
      "name": "M-DID Bootstrapping Exception Undermines R-DID Privacy",
      "category": "Schemas",
      "lifecyclePhase": "Phase 1–3",
      "description": "Spec §5.2 permits M-DIDs 'for bootstrapping' with no normative migration trigger or timeline. The Privacy Considerations section (§9) recommends migration to R-DIDs post-bootstrapping but does not make this a normative requirement. In practice, if migration never happens — the likely outcome without a phase-gate — early VRC relationships remain M-DID-based. An adversary monitoring the trust registry during the bootstrapping phase can reconstruct membership graphs from M-DID co-occurrences in VRCs issued before migration. **Introduced by:** DTG Credential Spec v0.3 §5.2 and Privacy Considerations §9 (RAHP commentary §2.5).",
      "harmType": [
        "Privacy",
        "Governance Failure"
      ],
      "severity": "Medium",
      "likelihood": "High",
      "harm_description": "The R-DID architecture's privacy guarantee is contingent on migration actually happening. Without a normative trigger, the bootstrapping exception becomes the permanent operating mode for many implementations. State actors and registry observers can reconstruct trust graphs from the pre-migration VRC corpus.",
      "affectedMetrics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-09",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-17"
      ],
      "userStories": [
