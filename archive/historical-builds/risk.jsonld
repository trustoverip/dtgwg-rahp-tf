    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-HX04",
      "@type": "Risk",
      "name": "Incapacity / Unsupported Decision-Making Exclusion",
      "category": "Human Experience",
      "lifecyclePhase": "Phase 3–4 / Ongoing",
      "description": "The VTC admission and ongoing participation architecture assumes all members are adults with full independent legal capacity. Persons who require supported decision-making — including minors with SEN (EC1), adults with progressive cognitive impairment (EC2a), and others acting under delegated authority — are structurally excluded or forced into non-compliant workarounds. The credential architecture has no concept of co-signed or supported consent distinct from substituted decision-making.",
      "harmType": [
        "Exclusion",
        "Discrimination"
      ],
      "severity": "High",
      "likelihood": "High",
      "harm_description": "Persons requiring support are excluded from VTC participation entirely, or their participation is mediated through impersonation-equivalent workarounds (a guardian using their own DID on behalf of the member). Admission denials fall disproportionately on disabled people, older adults with declining capacity, and minors — groups with legal protection against discrimination. Governance decisions affecting these members lack due process adapted to their situation.",
      "affectedMetrics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-07",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-12",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-19",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-31",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-32"
      ],
      "userStories": [
