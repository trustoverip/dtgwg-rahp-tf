    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/RK-ID05",
      "@type": "Risk",
      "name": "M-DID Linkability Across VTCs",
      "category": "Identity",
      "lifecyclePhase": "All phases",
      "description": "If a member uses the same M-DID across VTCs, or if the trust registry exposes sufficient metadata, an adversary can construct a cross-community profile. **SPEC UPDATE (v0.3 §5.2):** The spec's R-DID MUST requirement — one new unique R-DID per relationship — materially reduces this risk for compliant implementations. However, the M-DID bootstrapping exception (Privacy Considerations §9) creates a residual window: if migration to R-DIDs is never triggered normatively, early-phase M-DID usage remains linkable.",
      "harmType": [
        "Privacy",
        "Surveillance"
      ],
      "severity": "Medium",
      "likelihood": "Low",
      "harm_description": "Member's full community participation graph exposed; surveillance by state actors; chilling effect on membership in politically sensitive VTCs.",
      "affectedMetrics": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-09",
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/M-17"
