    {
      "@id": "https://trustoverip.github.io/dtgwg-rahp-tf/id/SC-27",
      "@type": "Scenario",
      "name": "Minor Capacity Transition — Credential Continuity at Age 18",
      "description": "Mia turns 18. The guardian-mediated wallet must transfer full credential control to her without loss of membership history or trust-graph relationships, and without triggering a re-admission workflow.",
      "lifecyclePhase": "Credential Lifecycle / Capacity Transition",
      "legitimate_personas": [
        "https://trustoverip.github.io/dtgwg-rahp-tf/id/EC1"
      ],
      "governance_decisions": "1. Is the transition from delegated to sole control a credential lifecycle event or a new admission?\n2. How is the prior guardian delegation credential revoked cleanly on transition?\n3. Is membership history preserved across the transition?",
      "userStories": [
